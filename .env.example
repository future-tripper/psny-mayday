# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./mayday.db

# Admin secret for database reset endpoint
# Usage: curl -X POST "http://localhost:8000/admin/reset?key=YOUR_SECRET"
ADMIN_SECRET=change-me-to-something-secure

# Python version (used by Render)
PYTHON_VERSION=3.11.0
